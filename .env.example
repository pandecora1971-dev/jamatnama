# JAMATNAMA configuration. Names only: never commit values or paste them into chat.
# Production values belong in Vercel Environment Variables (and the scanner host's secret store).
# docs/DEPLOYMENT.md explains where each value comes from.

# --- Application identity and security (required in production) ---
PUBLIC_ORIGIN=
COOKIE_SECURE=false
# Keep the existing values from your current deployment so that Super Admin access carries over.
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
SESSION_SECRET=
# 64 hex characters. Seals moderator authenticator secrets. Losing it locks out every moderator's MFA.
MFA_ENCRYPTION_KEY=
# At least 32 characters. Vercel Cron sends it as a bearer token to /api/cron/maintenance.
CRON_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Database ---
# Application: jamatnama_app role through the Supavisor transaction pooler (port 6543).
DATABASE_URL=
# Base64 of the Supabase CA certificate. Required for any non-local database.
DATABASE_CA_CERT=
# Connections per Vercel instance. Instances x this value must stay under the pooler's client limit.
DB_POOL_MAX=5
# Owner connection for migrations and backups only (direct or session mode). Never set this in Vercel.
# DATABASE_ADMIN_URL=
# Used once with npm run db:set-password. Never set this in Vercel.
# DB_ROLE_PASSWORD=

# --- Private Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Local testing only; replaces the endpoint derived from R2_ACCOUNT_ID.
# R2_ENDPOINT=

# --- Upload policy (defaults shown) ---
# UPLOADS_ENABLED=true
# UPLOAD_MAX_FILES=5
# UPLOAD_MAX_TOTAL_MB=3072
# UPLOAD_MAX_IMAGE_MB=25
# UPLOAD_MAX_DOCUMENT_MB=50
# UPLOAD_MAX_AUDIO_MB=200
# UPLOAD_MAX_VIDEO_MB=2048
# UPLOAD_BUDGET_TOTAL_GB=800
# UPLOAD_BUDGET_DAILY_GB=40

# --- Scan worker host only (not Vercel) ---
# DATABASE_URL=   (jamatnama_scanner role on that host)
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310

# --- Operator machine only: backups ---
# BACKUP_ENCRYPTION_KEY=   (64 hex characters; store it apart from the backups)
# R2_BACKUP_BUCKET=
